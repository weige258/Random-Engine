{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "cmake",
            "command": "build",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/Build", "--config", "Release"],
            "group": "build"
        },
        {
            "label": "Build RelWithDebInfo",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/Build", "--config", "RelWithDebInfo"],
            "group": "build"
        }
    ]
}